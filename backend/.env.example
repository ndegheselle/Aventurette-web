# The one file to edit when deploying. Copy to .env in backend/ on the server:
#
#   cp .env.example .env && nano .env
#
# Read by `docker compose` and by scripts/init-certificate.sh. From here the domains reach
# the nginx vhosts, the Let's Encrypt certificate and the API URL compiled into both bundles —
# they are not written anywhere else. (frontend/admin/.env is a different file, for the local dev
# server only.)
#
# Every domain below needs an A record pointing at this server, and all of them are on one
# certificate.

# The bare domain. It names the certificate and redirects to APP_DOMAIN.
DOMAIN=lubriciel.ovh

# The clients' app, the Flutter web build from frontend/mobile/.
APP_DOMAIN=app.lubriciel.ovh

# The back office, from frontend/admin/.
ADMIN_DOMAIN=admin.lubriciel.ovh

# PocketBase.
API_DOMAIN=api.lubriciel.ovh

# Where Let's Encrypt sends expiry warnings if a renewal ever fails.
CERTBOT_EMAIL=nicolas@degheselle.com
