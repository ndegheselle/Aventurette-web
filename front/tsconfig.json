{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "lib": ["es2024", "DOM"],
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "types": [
            "vite/client"
        ],
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": false,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        /* Workspace packages resolve to source, so `vue-tsc -b` typechecks them too and
           Vite gives cross-package HMR. Keep these in sync with vite.config.ts aliases. */
        "paths": {
            "@chapelure/core": [ "../packages/core/src/index.ts" ],
            "@chapelure/core/*": [ "../packages/core/src/*" ],
            "@chapelure/pocketbase": [ "../packages/pocketbase/src/index.ts" ],
            "@chapelure/pocketbase/*": [ "../packages/pocketbase/src/*" ],
            "@chapelure/ui": [ "../packages/ui/src/index.ts" ],
            "@chapelure/ui/*": [ "../packages/ui/src/*" ],
            "@features/*": [ "./src/features/*" ],
            "@/*": [ "./src/*" ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue"
    ]
}
