{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "front",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "go",
      "runtimeArgs": ["-C", "backend/api", "run", ".", "serve"],
      "port": 8090
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd frontend\\mobile && flutter run -d web-server --web-port 8081 --dart-define=API_URL=http://127.0.0.1:8090"],
      "port": 8081
    },
    {
      "name": "mobile-android",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd frontend\\mobile && flutter emulators --launch Pixel_2_API_33 && flutter run -d emulator-5554 --device-timeout 180 --host-vmservice-port 8182 --disable-service-auth-codes --dart-define=API_URL=http://10.0.2.2:8090"],
      "port": 8182
    }
  ]
}
