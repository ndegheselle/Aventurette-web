{
    "name": "aventurette-web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "packages/*",
        "front"
    ],
    "scripts": {
        "dev": "npm run dev --workspace @sagace/front",
        "build": "npm run build --workspace @sagace/front",
        "preview": "npm run preview --workspace @sagace/front",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint:arch": "node scripts/lint-arch.mjs",
        "check": "npm run lint:arch && npm run build && npm run test"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^5.0.0",
        "@vue/test-utils": "^2.5.0",
        "happy-dom": "^20.14.3",
        "vitest": "^5.0.0"
    }
}
