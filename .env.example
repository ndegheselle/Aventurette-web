# The one file to edit when deploying. Copy to .env on the server:
#
#   cp .env.example .env && nano .env
#
# Read by `docker compose` and by scripts/init-certificate.sh. From here the domain reaches
# the nginx vhosts, the Let's Encrypt certificate and the front bundle's API URL — it is not
# written anywhere else. (front/.env is a different file, for the local dev server only.)

# The site. Needs an A record pointing at this server.
DOMAIN=lubriciel.ovh

# PocketBase. Needs its own A record, and is covered by the same certificate as DOMAIN.
API_DOMAIN=api.lubriciel.ovh

# Where Let's Encrypt sends expiry warnings if a renewal ever fails.
CERTBOT_EMAIL=nicolas@degheselle.com
